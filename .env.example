# Copie este arquivo para .env e ajuste os valores conforme o ambiente.

DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados: sqlite (padrão, nao precisa de mais nada) ou postgres
DB_ENGINE=sqlite
# Preencha estes 5 campos somente se DB_ENGINE=postgres:
# DB_NAME=gestao_voos
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
